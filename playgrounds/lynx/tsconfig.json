{
	"compilerOptions": {
		"target": "ES2025",
		"lib": ["ES2025"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node", "@sohedra/lynx/client"],
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"svelteOptions": { "namespace": "svelteLynx" },
	"include": ["src"]
}
