{
	// The base of an app's tsconfig.json: `"extends": "@sohedra/lynx/tsconfig"`. Lynx's threads have
	// the language through ES2025, as the build lowers the syntax and `@sohedra/lynx-polyfill` (which
	// the app template imports) fills the built-ins their engine lacks, and no DOM, so a DOM name used
	// in a component fails the check instead of on the device. `@sohedra/lynx/client` declares the
	// globals a thread has, and each import of the polyfill the ones it fills. The app's own
	// tsconfig.json sets `"svelteOptions": { "namespace": "svelteLynx" }`, which the Svelte tools read
	// from that file only.
	"compilerOptions": {
		"target": "ES2025",
		"lib": ["ES2025"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["@sohedra/lynx/client"],
		"strict": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		// Imports name the file as it is (`./feed.ts`), as in this repository; the build bundles them.
		"allowImportingTsExtensions": true,
		// Svelte's and Rsbuild's declarations name the DOM's types, which the base leaves out: their
		// files are theirs to check.
		"skipLibCheck": true
	}
}
