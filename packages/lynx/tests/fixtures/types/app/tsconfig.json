{
	// As an app's: Lynx's threads have no DOM, and every declaration file is checked, the binding's
	// included.
	"compilerOptions": {
		"target": "ES2021",
		"lib": ["ES2021"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": [],
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": false
	},
	"svelteOptions": { "namespace": "svelteLynx" },
	"include": ["src"]
}
