{
	"name": "@sohedra/lynx",
	"version": "0.0.0",
	"private": true,
	"description": "Svelte on Lynx",
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": [
		"./src/background/background-only.ts",
		"./src/background/start-up.ts",
		"./src/first-frame/**",
		"./src/main-thread/**",
		"./lib/background/background-only.js",
		"./lib/background/start-up.js",
		"./lib/first-frame/**",
		"./lib/main-thread/**"
	],
	"exports": {
		"./config/rsbuild": "./src/build/plugin/index.ts",
		"./config/rstest": "./src/build/presets/rstest.ts",
		"./config/svelte": "./src/build/svelte-config/index.ts",
		"./env": "./src/env/index.ts",
		"./internal/renderer": "./src/background/renderer/entry.ts",
		"./internal/page": {
			"worker": "./src/first-frame/page.ts",
			"default": "./src/background/page-entry.ts"
		},
		"./client": {
			"types": "./types/client.d.ts"
		}
	},
	"publishConfig": {
		"exports": {
			"./config/rsbuild": {
				"types": "./lib/build/plugin/index.d.ts",
				"default": "./lib/build/plugin/index.js"
			},
			"./config/rstest": {
				"types": "./lib/build/presets/rstest.d.ts",
				"default": "./lib/build/presets/rstest.js"
			},
			"./config/svelte": {
				"types": "./lib/build/svelte-config/index.d.ts",
				"default": "./lib/build/svelte-config/index.js"
			},
			"./env": {
				"types": "./lib/env/index.d.ts",
				"default": "./lib/env/index.js"
			},
			"./internal/renderer": {
				"types": "./lib/background/renderer/entry.d.ts",
				"default": "./lib/background/renderer/entry.js"
			},
			"./internal/page": {
				"types": "./lib/background/page-entry.d.ts",
				"worker": "./lib/first-frame/page.js",
				"default": "./lib/background/page-entry.js"
			},
			"./client": {
				"types": "./types/client.d.ts"
			}
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "rstest"
	},
	"dependencies": {
		"@lynx-js/rsbuild-plugin": "^0.1.9",
		"@lynx-js/runtime-wrapper-webpack-plugin": "^0.2.6",
		"@lynx-js/tasm": "0.0.53",
		"@lynx-js/template-webpack-plugin": "^0.16.8",
		"@lynx-js/webpack-dev-transport": "^0.4.1",
		"es-module-lexer": "^3.0.5"
	},
	"devDependencies": {
		"@lynx-js/rspeedy": "^0.18.6",
		"@rsbuild/core": "^2.3.2",
		"@rstest/adapter-rsbuild": "^0.12.6",
		"@rstest/core": "^0.12.6",
		"@rstest/coverage-istanbul": "^0.12.6",
		"@testing-library/dom": "^10.4.2",
		"@types/node": "^26.6.6",
		"acorn": "^8.19.0",
		"jsdom": "^31.0.1",
		"svelte": "https://pkg.svelte.dev/svelte/c/f7b26fed5a7391b146253fdddad7efa039dbcfea",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@lynx-js/rspeedy": "^0.18.0",
		"@rsbuild/core": "^2.0.0",
		"@rstest/adapter-rsbuild": "^0.12.0",
		"@rstest/core": "^0.12.0",
		"@testing-library/dom": "^10.4.0",
		"jsdom": ">=28.0.0",
		"svelte": "*"
	},
	"peerDependenciesMeta": {
		"@lynx-js/rspeedy": {
			"optional": true
		},
		"@rstest/adapter-rsbuild": {
			"optional": true
		},
		"@rstest/core": {
			"optional": true
		},
		"@testing-library/dom": {
			"optional": true
		},
		"jsdom": {
			"optional": true
		}
	}
}
