{
	"name": "@sohedra/lynx",
	"version": "0.0.0",
	"private": true,
	"description": "Svelte on Lynx",
	"license": "Apache-2.0",
	"files": [
		"lib",
		"types",
		"NOTICE"
	],
	"type": "module",
	"sideEffects": [
		"./src/background/background-only.ts",
		"./src/background/dev-client.ts",
		"./src/background/start-up.ts",
		"./src/first-frame/**",
		"./src/main-thread/**",
		"./lib/background/background-only.js",
		"./lib/background/dev-client.js",
		"./lib/background/start-up.js",
		"./lib/first-frame/**",
		"./lib/main-thread/**"
	],
	"exports": {
		".": {
			"worker": "./src/first-frame/root-entry.ts",
			"default": "./src/background/root-entry.ts"
		},
		"./config/rsbuild": "./src/build/plugin/index.ts",
		"./config/rstest": "./src/build/presets/rstest.ts",
		"./config/vitest": "./src/build/presets/vitest.ts",
		"./config/svelte": "./src/build/svelte-config/index.ts",
		"./elements": {
			"types": "./types/elements.d.ts"
		},
		"./env": "./src/env/index.ts",
		"./experimental": "./src/gesture/experimental.ts",
		"./gesture": "./src/gesture/index.ts",
		"./host": {
			"worker": "./src/first-frame/host-entry.ts",
			"default": "./src/background/host-entry.ts"
		},
		"./testing": "./src/testing/library-entry.ts",
		"./internal/renderer": "./src/background/renderer/entry.ts",
		"./internal/main-thread-functions": {
			"worker": "./src/first-frame/functions-entry.ts",
			"default": "./src/background/functions-entry.ts"
		},
		"./client": {
			"types": "./types/client.d.ts"
		},
		"./tsconfig": "./types/tsconfig.base.json",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./types/bundled/index.d.ts",
				"worker": "./lib/first-frame/root-entry.js",
				"default": "./lib/background/root-entry.js"
			},
			"./config/rsbuild": {
				"types": "./types/bundled/config/rsbuild.d.ts",
				"default": "./lib/build/plugin/index.js"
			},
			"./config/rstest": {
				"types": "./types/bundled/config/rstest.d.ts",
				"default": "./lib/build/presets/rstest.js"
			},
			"./config/vitest": {
				"types": "./types/bundled/config/vitest.d.ts",
				"default": "./lib/build/presets/vitest.js"
			},
			"./config/svelte": {
				"types": "./types/bundled/config/svelte.d.ts",
				"default": "./lib/build/svelte-config/index.js"
			},
			"./elements": {
				"types": "./types/elements.d.ts"
			},
			"./env": {
				"types": "./types/bundled/env.d.ts",
				"default": "./lib/env/index.js"
			},
			"./experimental": {
				"types": "./types/bundled/experimental.d.ts",
				"default": "./lib/gesture/experimental.js"
			},
			"./gesture": {
				"types": "./types/bundled/gesture.d.ts",
				"default": "./lib/gesture/index.js"
			},
			"./host": {
				"types": "./types/bundled/host.d.ts",
				"worker": "./lib/first-frame/host-entry.js",
				"default": "./lib/background/host-entry.js"
			},
			"./testing": {
				"types": "./types/bundled/testing.d.ts",
				"default": "./lib/testing/library-entry.js"
			},
			"./internal/renderer": {
				"types": "./lib/background/renderer/entry.d.ts",
				"default": "./lib/background/renderer/entry.js"
			},
			"./internal/main-thread-functions": {
				"types": "./lib/background/functions-entry.d.ts",
				"worker": "./lib/first-frame/functions-entry.js",
				"default": "./lib/background/functions-entry.js"
			},
			"./client": {
				"types": "./types/client.d.ts"
			},
			"./tsconfig": "./types/tsconfig.base.json",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc -p tsconfig.json --noEmit",
		"declarations": "node scripts/declarations/write.ts",
		"generate": "node scripts/types/generate.ts",
		"test": "rstest"
	},
	"dependencies": {
		"@lynx-js/rsbuild-plugin": "^0.1.9",
		"@lynx-js/runtime-wrapper-webpack-plugin": "^0.2.6",
		"@lynx-js/tasm": "0.0.53",
		"@lynx-js/template-webpack-plugin": "^0.16.8",
		"@lynx-js/webpack-dev-transport": "^0.4.1",
		"@ungap/event-target": "^0.2.4",
		"@ungap/structured-clone": "^1.4.0",
		"es-module-lexer": "^3.0.5"
	},
	"devDependencies": {
		"@lynx-js/rspeedy": "^0.18.6",
		"@lynx-js/types": "4.4.2",
		"@rsbuild/core": "^2.3.2",
		"@rsbuild/plugin-less": "^2.0.1",
		"@rsbuild/plugin-sass": "^2.0.1",
		"@rsdoctor/rspack-plugin": "^1.6.5",
		"@rstest/adapter-rsbuild": "^0.12.6",
		"@rstest/core": "^0.12.6",
		"@rstest/coverage-istanbul": "^0.12.6",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@types/node": "^26.6.6",
		"@types/ungap__structured-clone": "^1.2.0",
		"acorn": "^8.19.0",
		"dts-buddy": "^0.8.3",
		"fast-check": "^4.10.2",
		"jsdom": "^31.0.1",
		"oxfmt": "^0.78.0",
		"publint": "^0.3.25",
		"svelte": "~5.59.0",
		"svelte-check": "^4.7.8",
		"svelte-without-renderers": "npm:svelte@5.58.0",
		"svelte2tsx": "^0.7.63",
		"tailwindcss": "^3.4.19",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"peerDependencies": {
		"@lynx-js/rspeedy": "^0.18.6",
		"@rsbuild/core": "^2.3.2",
		"@rstest/adapter-rsbuild": "^0.12.6",
		"@rstest/core": "^0.12.6",
		"@testing-library/dom": "^10.4.2",
		"jsdom": "^31.0.1",
		"svelte": "~5.59.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"peerDependenciesMeta": {
		"@lynx-js/rspeedy": {
			"optional": true
		},
		"@rstest/adapter-rsbuild": {
			"optional": true
		},
		"@rstest/core": {
			"optional": true
		},
		"@testing-library/dom": {
			"optional": true
		},
		"jsdom": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || ^26.0.0"
	}
}
