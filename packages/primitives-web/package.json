{
	"name": "@sohedra/primitives-web",
	"version": "0.0.0",
	"description": "Headless, unstyled, accessible components for Svelte on the web.",
	"keywords": [
		"a11y",
		"accessibility",
		"components",
		"headless",
		"svelte",
		"ui",
		"unstyled"
	],
	"homepage": "https://github.com/sohedra/sohedra#readme",
	"bugs": "https://github.com/sohedra/sohedra/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sohedra/sohedra.git",
		"directory": "packages/primitives-web"
	},
	"files": [
		"dist",
		"NOTICE.txt"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#lib": "./src/index.js",
		"#lib/*": "./src/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./popover": {
			"types": "./dist/components/popover/index.d.ts",
			"svelte": "./dist/components/popover/index.js",
			"default": "./dist/components/popover/index.js"
		},
		"./switch": {
			"types": "./dist/components/switch/index.d.ts",
			"svelte": "./dist/components/switch/index.js",
			"default": "./dist/components/switch/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "svelte-package -i src --watch",
		"build": "pnpm run prepack",
		"prepack": "svelte-package -i src && publint",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run --project ssr --project \"browser (chromium)\"",
		"test:async": "vitest run --mode async --project ssr --project \"browser (chromium)\"",
		"test:webkit": "vitest run --project ssr --project \"browser (webkit)\"",
		"test:webkit:async": "vitest run --mode async --project ssr --project \"browser (webkit)\""
	},
	"dependencies": {
		"@floating-ui/dom": "1.8.0",
		"@sohedra/primitives-core": "workspace:*",
		"esm-env": "^1.2.2"
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@tsconfig/svelte": "^5.0.9",
		"@vitest/browser-playwright": "5.1.1",
		"axe-core": "4.14.0",
		"playwright": "~1.64.1",
		"publint": "^0.3.25",
		"svelte": "~5.59.0",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"vitest-browser-svelte": "^3.1.0"
	},
	"peerDependencies": {
		"svelte": "^5.57.0"
	},
	"sohedra": {
		"runsOn": [
			"web"
		]
	}
}
