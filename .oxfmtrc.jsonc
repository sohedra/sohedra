{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"proseWrap": "always",
	"sortImports": true,
	"svelte": true,
	// The npm packages @sohedra/lynx-polyfill bundles, kept byte for byte as the bundle step
	// writes them (a test bundles again and compares); and the feature table as its generator
	// writes it, whose Markdown table formatting would pad to five times its size.
	"ignorePatterns": [
		"modules/lynx-polyfill/src/fills/vendor/**",
		"modules/lynx-polyfill/scripts/feature-table/feature-table.*",
	],
	"overrides": [
		{
			// YAML forbids tabs; GitHub shows them eight wide in Markdown
			"files": ["*.md", "*.yml", "*.yaml"],
			"options": { "useTabs": false },
		},
		{
			// Issue and pull request bodies keep single line breaks
			"files": [".github/**/*.md"],
			"options": { "proseWrap": "preserve" },
		},
	],
}
