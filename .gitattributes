# Store text files with LF line endings, whatever the contributor's platform.
* text=auto eol=lf

# Generated by pnpm: collapsed in GitHub diffs and left out of language statistics.
pnpm-lock.yaml linguist-generated=true

# Bundled from npm packages by modules/lynx-polyfill/scripts/vendor/bundle.ts, as their authors wrote them.
modules/lynx-polyfill/src/fills/vendor/*.js linguist-generated=true

# VS Code reads its settings as JSON with comments; tell GitHub, so comments aren't marked as errors.
.vscode/*.json linguist-language=jsonc
