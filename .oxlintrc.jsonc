{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["import", "oxc", "typescript", "unicorn", "vitest"],
	"categories": {
		"correctness": "error",
	},
	"options": {
		"denyWarnings": true,
		"reportUnusedDisableDirectives": "error",
		"typeAware": true,
	},
	"rules": {
		// Bugs
		"array-callback-return": "error",
		"eqeqeq": ["error", "smart"],
		"no-self-compare": "error",
		"no-template-curly-in-string": "error",
		"typescript/no-misused-promises": "error",

		// Unused and outdated code
		"no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"ignoreRestSiblings": true,
				"varsIgnorePattern": "^_",
			},
		],
		"no-var": "error",
		"prefer-const": "error",

		// TypeScript
		"typescript/ban-ts-comment": "error",
		"typescript/no-explicit-any": "error",

		// Imports
		"import/no-cycle": "error",
		"import/no-duplicates": "error",
		"import/no-mutable-exports": "error",
		"import/no-self-import": "error",
		"typescript/consistent-type-imports": "error",
		"typescript/no-import-type-side-effects": "error",

		// Strict CSP: no code built from strings
		"no-new-func": "error",
		"no-script-url": "error",

		// Tests
		"vitest/expect-expect": [
			"error",
			{
				"assertFunctionNames": ["assert*", "expect", "expect*"],
			},
		],
		"vitest/no-commented-out-tests": "error",
		"vitest/no-identical-title": "error",
		"vitest/no-import-node-test": "error",
		"vitest/no-interpolation-in-snapshots": "error",
		"vitest/no-mocks-import": "error",
		"vitest/no-unneeded-async-expect-function": "error",
		"vitest/prefer-called-exactly-once-with": "error",

		// TypeScript already checks namespace members; this only adds false alarms on `entry[name]`
		"import/namespace": "off",
		// False alarms on methods that use closures, not `this`
		"typescript/unbound-method": "off",
		// Shared suites branch on their options
		"vitest/no-conditional-tests": "off",
		// Would require type parameters on every `vi.fn()`
		"vitest/require-mock-type-parameters": "off",
	},
	"overrides": [
		{
			"files": ["packages/*/src/**"],
			"rules": {
				"no-console": "error",
			},
		},
		{
			// A thread's globals are reached through the typed `globals.ts` of its folder: any other
			// global is undefined here (Node's only in the Node programs), and so is `globalThis`.
			"files": ["packages/lynx/src/**"],
			"rules": {
				"no-undef": "error",
				"no-restricted-globals": [
					"error",
					{ "name": "globalThis", "message": "Reach globals through this folder's globals.ts." },
				],
			},
		},
		{
			"files": [
				"packages/lynx/src/build/**",
				"packages/lynx/src/svelte/build/**",
				"packages/lynx/src/testing/**",
			],
			"env": { "node": true },
		},
		{
			"files": ["packages/lynx/src/**/globals.ts"],
			"rules": { "no-restricted-globals": "off" },
		},

		// Which folder of the binding may import which (the table in packages/lynx/AGENTS.md).
		// Each folder's own `index.ts` is its only face to the others, named as that file: not as the
		// folder, and not by a path with a detour (`./../x`). Svelte's internals are touched only in
		// src/svelte/. A `!` pattern lets its paths past every pattern of the rule, so each allowed
		// face is written once per depth (up to three folders deep), never with `**`.
		// May import: Nothing of the binding
		{
			"files": ["packages/lynx/src/wire/**"],
			"rules": {
				// Node's modules are not on a Lynx thread, with or without the `node:` prefix.
				"import/no-nodejs-modules": "error",
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../**/wire",
									"../**/wire/**",
									"../build",
									"../build/**",
									"../../build",
									"../../build/**",
									"../../../build",
									"../../../build/**",
									"../**/background",
									"../**/background/**",
									"../**/main-thread",
									"../**/main-thread/**",
									"../**/first-frame",
									"../**/first-frame/**",
									"../**/svelte/build",
									"../**/svelte/build/**",
									"../**/svelte/runtime",
									"../**/svelte/runtime/**",
									"../**/testing",
									"../**/testing/**",
									"../**/gesture",
									"../**/gesture/**",
									"../**/host",
									"../**/host/**",
									"../**/env",
									"../**/env/**",
								],
								"message": "A folder imports only the folders in its row of the import table, each through its index.ts.",
							},
							{
								"regex": "^\\./\\.\\.(/|$)|/\\.(/|$)|//|(^|/)([^./][^/]*|\\.[^./][^/]*|\\.\\.[^/]+)/\\.\\.(/|$)",
								"message": "Write the path without a detour: no ./.. at its start, and no . or .. after a folder's name.",
							},
							{
								"group": [
									"svelte/internal",
									"svelte/internal/**",
									"svelte/compiler",
									"svelte/src/**",
								],
								"message": "Svelte's internals are touched only in src/svelte/.",
							},
						],
					},
				],
			},
		},
		// May import: Nothing of the binding
		{
			"files": ["packages/lynx/src/svelte/runtime/**"],
			"rules": {
				// Node's modules are not on a Lynx thread, with or without the `node:` prefix.
				"import/no-nodejs-modules": "error",
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../**/wire",
									"../**/wire/**",
									"../build",
									"../build/**",
									"../../build",
									"../../build/**",
									"../../../build",
									"../../../build/**",
									"../**/background",
									"../**/background/**",
									"../**/main-thread",
									"../**/main-thread/**",
									"../**/first-frame",
									"../**/first-frame/**",
									"../**/svelte/build",
									"../**/svelte/build/**",
									"../**/svelte/runtime",
									"../**/svelte/runtime/**",
									"../**/testing",
									"../**/testing/**",
									"../**/gesture",
									"../**/gesture/**",
									"../**/host",
									"../**/host/**",
									"../**/env",
									"../**/env/**",
								],
								"message": "A folder imports only the folders in its row of the import table, each through its index.ts.",
							},
							{
								"regex": "^\\./\\.\\.(/|$)|/\\.(/|$)|//|(^|/)([^./][^/]*|\\.[^./][^/]*|\\.\\.[^/]+)/\\.\\.(/|$)",
								"message": "Write the path without a detour: no ./.. at its start, and no . or .. after a folder's name.",
							},
						],
					},
				],
			},
		},
		// May import: Nothing of the binding
		{
			"files": ["packages/lynx/src/svelte/build/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../**/wire",
									"../**/wire/**",
									"../build",
									"../build/**",
									"../../build",
									"../../build/**",
									"../../../build",
									"../../../build/**",
									"../**/background",
									"../**/background/**",
									"../**/main-thread",
									"../**/main-thread/**",
									"../**/first-frame",
									"../**/first-frame/**",
									"../**/svelte/build",
									"../**/svelte/build/**",
									"../**/svelte/runtime",
									"../**/svelte/runtime/**",
									"../**/testing",
									"../**/testing/**",
									"../**/gesture",
									"../**/gesture/**",
									"../**/host",
									"../**/host/**",
									"../**/env",
									"../**/env/**",
									"../runtime",
									"../runtime/**",
									"../../runtime",
									"../../runtime/**",
								],
								"message": "A folder imports only the folders in its row of the import table, each through its index.ts.",
							},
							{
								"regex": "^\\./\\.\\.(/|$)|/\\.(/|$)|//|(^|/)([^./][^/]*|\\.[^./][^/]*|\\.\\.[^/]+)/\\.\\.(/|$)",
								"message": "Write the path without a detour: no ./.. at its start, and no . or .. after a folder's name.",
							},
						],
					},
				],
			},
		},
		// May import: wire/
		{
			"files": [
				"packages/lynx/src/main-thread/**",
				"packages/lynx/src/first-frame/**",
				"packages/lynx/src/gesture/**",
				"packages/lynx/src/host/**",
				"packages/lynx/src/env/**",
			],
			"rules": {
				// Node's modules are not on a Lynx thread, with or without the `node:` prefix.
				"import/no-nodejs-modules": "error",
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../**/wire",
									"../**/wire/**",
									"../build",
									"../build/**",
									"../../build",
									"../../build/**",
									"../../../build",
									"../../../build/**",
									"../**/background",
									"../**/background/**",
									"../**/main-thread",
									"../**/main-thread/**",
									"../**/first-frame",
									"../**/first-frame/**",
									"../**/svelte/build",
									"../**/svelte/build/**",
									"../**/svelte/runtime",
									"../**/svelte/runtime/**",
									"../**/testing",
									"../**/testing/**",
									"../**/gesture",
									"../**/gesture/**",
									"../**/host",
									"../**/host/**",
									"../**/env",
									"../**/env/**",
									"!../wire/index.ts",
									"!../../wire/index.ts",
									"!../../../wire/index.ts",
								],
								"message": "A folder imports only the folders in its row of the import table, each through its index.ts.",
							},
							{
								"regex": "^\\./\\.\\.(/|$)|/\\.(/|$)|//|(^|/)([^./][^/]*|\\.[^./][^/]*|\\.\\.[^/]+)/\\.\\.(/|$)",
								"message": "Write the path without a detour: no ./.. at its start, and no . or .. after a folder's name.",
							},
							{
								"group": [
									"svelte/internal",
									"svelte/internal/**",
									"svelte/compiler",
									"svelte/src/**",
								],
								"message": "Svelte's internals are touched only in src/svelte/.",
							},
						],
					},
				],
			},
		},
		// May import: wire/ and svelte/build/
		{
			"files": ["packages/lynx/src/build/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../**/wire",
									"../**/wire/**",
									"../build",
									"../build/**",
									"../../build",
									"../../build/**",
									"../../../build",
									"../../../build/**",
									"../**/background",
									"../**/background/**",
									"../**/main-thread",
									"../**/main-thread/**",
									"../**/first-frame",
									"../**/first-frame/**",
									"../**/svelte/build",
									"../**/svelte/build/**",
									"../**/svelte/runtime",
									"../**/svelte/runtime/**",
									"../**/testing",
									"../**/testing/**",
									"../**/gesture",
									"../**/gesture/**",
									"../**/host",
									"../**/host/**",
									"../**/env",
									"../**/env/**",
									"!../wire/index.ts",
									"!../../wire/index.ts",
									"!../../../wire/index.ts",
									"!../svelte/build/index.ts",
									"!../../svelte/build/index.ts",
									"!../../../svelte/build/index.ts",
								],
								"message": "A folder imports only the folders in its row of the import table, each through its index.ts.",
							},
							{
								"regex": "^\\./\\.\\.(/|$)|/\\.(/|$)|//|(^|/)([^./][^/]*|\\.[^./][^/]*|\\.\\.[^/]+)/\\.\\.(/|$)",
								"message": "Write the path without a detour: no ./.. at its start, and no . or .. after a folder's name.",
							},
							{
								"group": [
									"svelte/internal",
									"svelte/internal/**",
									"svelte/compiler",
									"svelte/src/**",
								],
								"message": "Svelte's internals are touched only in src/svelte/.",
							},
						],
					},
				],
			},
		},
		// May import: wire/ and svelte/runtime/
		{
			"files": ["packages/lynx/src/background/**"],
			"rules": {
				// Node's modules are not on a Lynx thread, with or without the `node:` prefix.
				"import/no-nodejs-modules": "error",
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../**/wire",
									"../**/wire/**",
									"../build",
									"../build/**",
									"../../build",
									"../../build/**",
									"../../../build",
									"../../../build/**",
									"../**/background",
									"../**/background/**",
									"../**/main-thread",
									"../**/main-thread/**",
									"../**/first-frame",
									"../**/first-frame/**",
									"../**/svelte/build",
									"../**/svelte/build/**",
									"../**/svelte/runtime",
									"../**/svelte/runtime/**",
									"../**/testing",
									"../**/testing/**",
									"../**/gesture",
									"../**/gesture/**",
									"../**/host",
									"../**/host/**",
									"../**/env",
									"../**/env/**",
									"!../wire/index.ts",
									"!../../wire/index.ts",
									"!../../../wire/index.ts",
									"!../svelte/runtime/index.ts",
									"!../../svelte/runtime/index.ts",
									"!../../../svelte/runtime/index.ts",
								],
								"message": "A folder imports only the folders in its row of the import table, each through its index.ts.",
							},
							{
								"regex": "^\\./\\.\\.(/|$)|/\\.(/|$)|//|(^|/)([^./][^/]*|\\.[^./][^/]*|\\.\\.[^/]+)/\\.\\.(/|$)",
								"message": "Write the path without a detour: no ./.. at its start, and no . or .. after a folder's name.",
							},
							{
								"group": [
									"svelte/internal",
									"svelte/internal/**",
									"svelte/compiler",
									"svelte/src/**",
								],
								"message": "Svelte's internals are touched only in src/svelte/.",
							},
						],
					},
				],
			},
		},
		// May import: every program but build/
		{
			"files": ["packages/lynx/src/testing/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../**/wire",
									"../**/wire/**",
									"../build",
									"../build/**",
									"../../build",
									"../../build/**",
									"../../../build",
									"../../../build/**",
									"../**/background",
									"../**/background/**",
									"../**/main-thread",
									"../**/main-thread/**",
									"../**/first-frame",
									"../**/first-frame/**",
									"../**/svelte/build",
									"../**/svelte/build/**",
									"../**/svelte/runtime",
									"../**/svelte/runtime/**",
									"../**/testing",
									"../**/testing/**",
									"../**/gesture",
									"../**/gesture/**",
									"../**/host",
									"../**/host/**",
									"../**/env",
									"../**/env/**",
									"!../wire/index.ts",
									"!../../wire/index.ts",
									"!../../../wire/index.ts",
									"!../background/index.ts",
									"!../../background/index.ts",
									"!../../../background/index.ts",
									"!../main-thread/index.ts",
									"!../../main-thread/index.ts",
									"!../../../main-thread/index.ts",
									"!../first-frame/index.ts",
									"!../../first-frame/index.ts",
									"!../../../first-frame/index.ts",
									"!../svelte/runtime/index.ts",
									"!../../svelte/runtime/index.ts",
									"!../../../svelte/runtime/index.ts",
								],
								"message": "A folder imports only the folders in its row of the import table, each through its index.ts.",
							},
							{
								"regex": "^\\./\\.\\.(/|$)|/\\.(/|$)|//|(^|/)([^./][^/]*|\\.[^./][^/]*|\\.\\.[^/]+)/\\.\\.(/|$)",
								"message": "Write the path without a detour: no ./.. at its start, and no . or .. after a folder's name.",
							},
							{
								"group": [
									"svelte/internal",
									"svelte/internal/**",
									"svelte/compiler",
									"svelte/src/**",
								],
								"message": "Svelte's internals are touched only in src/svelte/.",
							},
						],
					},
				],
			},
		},

		{
			// Type tests check types at compile time and have nothing to assert at runtime
			"files": ["packages/*/tests/types/**"],
			"rules": {
				"vitest/expect-expect": "off",
			},
		},
	],
}
